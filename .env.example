# PostgreSQL connection — set by Vercel automatically when you link a Postgres database.
# For local development: copy to .env.local and fill in your connection string.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# JWT signing secret — change this to a long random string
JWT_SECRET=change-me-in-production
