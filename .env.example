# PostgreSQL connection — set by Vercel automatically when you link a Postgres database.
# For local development: copy to .env.local and fill in your connection string.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# JWT signing secret — REQUIRED, no fallback. Set a long random string
# (e.g. `openssl rand -hex 32`) both locally and in Vercel project env vars.
JWT_SECRET=
